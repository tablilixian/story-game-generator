{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chapter",
  "description": "小说章节数据结构",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "章节唯一标识"
    },
    "title": {
      "type": "string",
      "description": "章节标题"
    },
    "content": {
      "type": "string",
      "description": "章节原文内容"
    },
    "order": {
      "type": "number",
      "description": "章节顺序"
    },
    "summary": {
      "type": "string",
      "description": "章节概要"
    },
    "characters": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本章出场的角色ID列表"
    },
    "scenes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本章关联的场景ID列表"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["dialogue", "narration", "action", "choice"] },
          "content": { "type": "string" },
          "character": { "type": "string" }
        }
      }
    }
  },
  "required": ["id", "title", "content", "order"]
}
